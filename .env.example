# Conexão PostgreSQL — Transferências Discricionárias (SICONV)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=transferepro
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=transfere_pro_transferegov

# Controle de carga (tabela controle_carga)
CONTROLE_CARGA_SCHEMA=transfere_pro_transferegov
CONTROLE_CARGA_ENABLED=true

# COPY em lotes para staging (linhas por chunk; padrão 50000)
COPY_CHUNK_ROWS=50000

# Encoding dos CSVs extraídos (dump SICONV em UTF-8)
CSV_ENCODING=utf-8-sig

# Base URL dos ZIPs individuais (API pública TransfereGov)
DOWNLOAD_BASE_URL=https://api-publica.transferegov.gestao.gov.br/downloads/dadosgov
